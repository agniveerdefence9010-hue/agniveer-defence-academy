{
  // Cloudflare Worker: serves the static site AND a small photo-upload API.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "agniveer-defence-academy",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "PHOTOS_KV", "id": "1b23fb994f874a65beca4578b94e3288" }
  ]
}
